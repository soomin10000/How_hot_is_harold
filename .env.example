# Copy to .env and fill in values, then: source .env && python3 harold.py

# From Tuya IoT Platform -> Cloud -> My Project -> Device -> Devices
HAROLD_ID=your_device_id_here
HAROLD_KEY=your_16char_local_key

# Optional
POLL_INTERVAL=5

# Only needed for discover.py
TUYA_API_KEY=your_api_key
TUYA_API_SECRET=your_api_secret
TUYA_REGION=eu
